            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="0" CPARENT="Default Character Style"/>
                <ITEXT CH="Zum Laden der ReactPods können diese mit jedem handelsüblichen USB-C-Kabel und Ladegerät geladen werden. "/>
