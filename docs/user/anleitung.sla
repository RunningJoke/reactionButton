                <ITEXT SCALEH="99" CH="SOLO-Modus: sobald der Pod grün leuchtet, drücken"/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="652.194225721785" YPOS="782.63619047619" OwnPage="3" ItemID="225637040" PTYPE="4" WIDTH="246.861522309711" HEIGHT="63.9277690288714" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L246.862 0 L246.862 63.9278 L0 63.9278 L0 0 Z" copath="M0 0 L246.862 0 L246.862 63.9278 L0 63.9278 L0 0 Z" gXpos="1491.24934383202" gYpos="782.63619047619" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
