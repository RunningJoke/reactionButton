                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140.00062992126" YPOS="720.473385826772" OwnPage="2" ItemID="226148576" PTYPE="4" WIDTH="339.527559055118" HEIGHT="52.1932808398949" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L339.528 0 L339.528 52.1933 L0 52.1933 L0 0 Z" copath="M0 0 L339.528 0 L339.528 52.1933 L0 52.1933 L0 0 Z" gXpos="559.528188976378" gYpos="85.1981102362189" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="0" CPARENT="Überschriften" FONTSIZE="12"/>
                <ITEXT CH="Standardmäßig benötigt ein Verbund aus ReactPods genau einen ReactPod im CENTRAL-Modus und entsprechend des gewählten Programms mehrere PERIPHERAL-ReactPods"/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="148.25062992126" YPOS="772.666666666667" OwnPage="2" ItemID="225605888" PTYPE="4" WIDTH="331.277559055118" HEIGHT="25.1968503937009" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L331.278 0 L331.278 25.1969 L0 25.1969 L0 0 Z" copath="M0 0 L331.278 0 L331.278 25.1969 L0 25.1969 L0 0 Z" gXpos="567.778188976382" gYpos="137.391391076115" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="0" CPARENT="Überschriften"/>
                <ITEXT CPARENT="Überschriften" CH="PERIPHERAL-Modus"/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="158.25062992126" YPOS="797.863517060367" OwnPage="2" ItemID="225583232" PTYPE="4" WIDTH="321.277559055118" HEIGHT="80.6666666666667" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L321.278 0 L321.278 80.6667 L0 80.6667 L0 0 Z" copath="M0 0 L321.278 0 L321.278 80.6667 L0 80.6667 L0 0 Z" gXpos="577.778188976378" gYpos="162.588241469815" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="0" CPARENT="Überschriften" FONTSIZE="12"/>
                <ITEXT CH="Ein ReactPod startet standardmäßig im PERIPHERAL-Modus. Sobald der ReactPod eingeschaltet wurde und das blaue Lauflicht erlöscht leuchtet der ReactPod gelb auf. Dann wartet er darauf, von einem CENTRAL-Pod aufgenommen zu werden. Sobald dies geschehen ist, erlischt der PERIPHERAL-Pod"/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="158.25062992126" YPOS="932.666666666667" OwnPage="2" ItemID="225611552" PTYPE="4" WIDTH="321.277559055118" HEIGHT="80.6666666666667" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L321.278 0 L321.278 80.6667 L0 80.6667 L0 0 Z" copath="M0 0 L321.278 0 L321.278 80.6667 L0 80.6667 L0 0 Z" gXpos="577.778188976378" gYpos="297.391391076114" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="0" CPARENT="Überschriften" FONTSIZE="12"/>
                <ITEXT CH="Um einen ReactPod im CENTRAL-Modus zu starten, drücke nach dem Anschalten während des blauen Lauflichts den Buzzer. Sobald das Licht erlöscht den Buzzer loslassen. Nun sollte eine Kombination aus LEDs leuchten, die das aktuell gewählte Programm anzeigt."/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="158.25062992126" YPOS="910.473385826772" OwnPage="2" ItemID="225586064" PTYPE="4" WIDTH="313.027559055118" HEIGHT="22.1932808398949" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L313.028 0 L313.028 22.1933 L0 22.1933 L0 0 Z" copath="M0 0 L313.028 0 L313.028 22.1933 L0 22.1933 L0 0 Z" gXpos="577.778188976378" gYpos="275.19811023622" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="0" CPARENT="Überschriften" FONT="Roboto Bold Condensed" FONTSIZE="17" FEATURES="inherit smallcaps"/>
                <ITEXT FONT="Roboto Bold Condensed" FONTSIZE="17" FEATURES="inherit smallcaps" CH="1. ReactPod im CENTRAL-Modus starten"/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="158.25062992126" YPOS="1035.52661417323" OwnPage="2" ItemID="225614384" PTYPE="4" WIDTH="321.277559055118" HEIGHT="96.9999999999998" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L321.278 0 L321.278 97 L0 97 L0 0 Z" copath="M0 0 L321.278 0 L321.278 97 L0 97 L0 0 Z" gXpos="577.778188976382" gYpos="400.251338582676" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="0" CPARENT="Überschriften" FONTSIZE="12"/>
                <ITEXT CH="Indem du den Buzzer wiederholt kurz drückst, kannst du durch die Programme wechseln. Auf der nächsten Seite sind die verschiedenen Programme erklärt. Wenn du das korrekte Programm gefunden hast, drücke und halte den Knopf. Eine weiße LED sollte heller werden. Sobald diese erlöscht, sucht der CENTRAL nach neuen PERIPHERAL-ReactPods"/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="158.25062992126" YPOS="1013.33333333333" OwnPage="2" ItemID="225617216" PTYPE="4" WIDTH="313.027559055118" HEIGHT="22.1932808398949" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L313.028 0 L313.028 22.1933 L0 22.1933 L0 0 Z" copath="M0 0 L313.028 0 L313.028 22.1933 L0 22.1933 L0 0 Z" gXpos="577.778188976382" gYpos="378.058057742782" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="0" CPARENT="Überschriften" FONT="Roboto Bold Condensed" FONTSIZE="17" FEATURES="inherit smallcaps"/>
                <ITEXT FONT="Roboto Bold Condensed" FONTSIZE="17" FEATURES="inherit smallcaps" CH="2. Programm wählen"/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="158.25062992126" YPOS="1154.71989501312" OwnPage="2" ItemID="225591728" PTYPE="4" WIDTH="321.277559055118" HEIGHT="55.8322309711277" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L321.278 0 L321.278 55.8322 L0 55.8322 L0 0 Z" copath="M0 0 L321.278 0 L321.278 55.8322 L0 55.8322 L0 0 Z" gXpos="577.778188976382" gYpos="519.444619422572" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="0" CPARENT="Überschriften" FONTSIZE="12"/>
                <ITEXT CH="Je nach Programm leuchten nun einige blaue LEDs. Sobald der CENTRAL ausreichend Peripherals für sein Programm gefunden hat, wechselt er auf grün und ist betriebsbereit."/>
                <para PARENT="Default Paragraph Style" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="158.25062992126" YPOS="1132.52661417323" OwnPage="2" ItemID="225620048" PTYPE="4" WIDTH="313.027559055118" HEIGHT="22.1932808398949" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L313.028 0 L313.028 22.1933 L0 22.1933 L0 0 Z" copath="M0 0 L313.028 0 L313.028 22.1933 L0 22.1933 L0 0 Z" gXpos="577.778188976382" gYpos="497.251338582678" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
