# platform/.env for local development (npm run dev); all optional
PORT=8787
# embedded database in ./.data/dev (default); or postgres://reactpod:reactpod@localhost:5432/reactpod with compose.dev.yaml
DATABASE_URL=pglite:./.data/dev
# sign-in codes are printed to the log while MAIL_URL is empty
# MAIL_URL=smtps://user:password@smtp.example.org:465
# APP_URL=http://localhost:5173/
