# /opt/reactpod/.env on the server (never commit the real file)
API_DOMAIN=api.staging.example.org
POSTGRES_PASSWORD=change-me-long-random
CORS_ORIGINS=https://runningjoke.github.io,http://localhost:5173,http://localhost:4173
APP_URL=https://runningjoke.github.io/reactionButton/
# SMTP for sign-in and invitation mails (provider with EU processing); empty = mails only in the log
MAIL_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM=ReactPod <no-reply@example.org>
# image tag; CI sets it per deploy (sha-<commit>)
API_TAG=feat-platform
